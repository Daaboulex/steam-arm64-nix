+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::symlink;
+
+    fn fake_host(name: &str) -> PathBuf {
+        let root = env::temp_dir().join(format!("muvm-resolv-{name}-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&root);
+        fs::create_dir_all(root.join("etc/static")).unwrap();
+        root
+    }
+
+    #[test]
+    fn follows_a_nixos_chain_into_run() {
+        let root = fake_host("nixos");
+        symlink("static/resolv.conf", root.join("etc/resolv.conf")).unwrap();
+        symlink(
+            "/run/systemd/resolve/stub-resolv.conf",
+            root.join("etc/static/resolv.conf"),
+        )
+        .unwrap();
+        assert_eq!(
+            resolv_conf_target_seen_from(&root),
+            PathBuf::from("/run/systemd/resolve/stub-resolv.conf")
+        );
+        fs::remove_dir_all(&root).unwrap();
+    }
+
+    #[test]
+    fn follows_a_relative_fedora_link_into_run() {
+        let root = fake_host("fedora");
+        symlink(
+            "../run/systemd/resolve/stub-resolv.conf",
+            root.join("etc/resolv.conf"),
+        )
+        .unwrap();
+        assert_eq!(
+            resolv_conf_target_seen_from(&root),
+            PathBuf::from("/run/systemd/resolve/stub-resolv.conf")
+        );
+        fs::remove_dir_all(&root).unwrap();
+    }
+
+    #[test]
+    fn leaves_a_plain_file_alone() {
+        let root = fake_host("plain");
+        fs::write(root.join("etc/resolv.conf"), "nameserver 192.0.2.1\n").unwrap();
+        assert_eq!(
+            resolv_conf_target_seen_from(&root),
+            PathBuf::from("/etc/resolv.conf")
+        );
+        fs::remove_dir_all(&root).unwrap();
+    }
+}
