+fn lexically_normal(path: &Path) -> PathBuf {
+    let mut normal = PathBuf::new();
+    for component in path.components() {
+        match component {
+            Component::ParentDir => {
+                normal.pop();
+            },
+            Component::CurDir => {},
+            other => normal.push(other.as_os_str()),
+        }
+    }
+    normal
+}
+
+fn resolv_conf_target_seen_from(host_root: &Path) -> PathBuf {
+    let mut link = PathBuf::from("/etc/resolv.conf");
+    for _ in 0..16 {
+        let relative = link.strip_prefix("/").unwrap_or(&link);
+        let Ok(next) = fs::read_link(host_root.join(relative)) else {
+            break;
+        };
+        let parent = link.parent().unwrap_or(Path::new("/"));
+        link = lexically_normal(&parent.join(next));
+        if link.starts_with("/run") {
+            break;
+        }
+    }
+    link
+}
+
+fn materialize_resolv_conf_target() -> Result<()> {
+    let target = resolv_conf_target_seen_from(Path::new("/run/muvm-host"));
+    if !target.starts_with("/run") || target.exists() {
+        return Ok(());
+    }
+    if let Some(dir) = target.parent() {
+        fs::create_dir_all(dir).with_context(|| format!("Failed to create {dir:?}"))?;
+    }
+    fs::copy("/run/resolv.conf", &target)
+        .with_context(|| format!("Failed to copy /run/resolv.conf to {target:?}"))?;
+    Ok(())
+}
